{
  "info": {
    "name": "Orders API - UTEC Cloud Computing 2026-2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {"raw": "http://{{host}}:8000/", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": [""]}
      }
    },
    {
      "name": "Get all orders",
      "request": {
        "method": "GET",
        "url": {"raw": "http://{{host}}:8000/orders", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": ["orders"]}
      }
    },
    {
      "name": "Get order by id",
      "request": {
        "method": "GET",
        "url": {"raw": "http://{{host}}:8000/orders/1", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": ["orders", "1"]}
      }
    },
    {
      "name": "Get orders by user",
      "request": {
        "method": "GET",
        "url": {"raw": "http://{{host}}:8000/orders/user/u001", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": ["orders", "user", "u001"]}
      }
    },
    {
      "name": "Get orders by restaurant",
      "request": {
        "method": "GET",
        "url": {"raw": "http://{{host}}:8000/orders/restaurant/r001", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": ["orders", "restaurant", "r001"]}
      }
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"u001\",\n  \"restaurant_id\": \"r001\",\n  \"address\": \"Av. Javier Prado 123\",\n  \"items\": [\n    {\"dish_id\": \"d001\", \"qty\": 2},\n    {\"dish_id\": \"d002\", \"qty\": 1}\n  ]\n}"
        },
        "url": {"raw": "http://{{host}}:8000/orders", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": ["orders"]}
      }
    },
    {
      "name": "Update order status",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DELIVERED\"\n}"
        },
        "url": {"raw": "http://{{host}}:8000/orders/1", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": ["orders", "1"]}
      }
    },
    {
      "name": "Delete order",
      "request": {
        "method": "DELETE",
        "url": {"raw": "http://{{host}}:8000/orders/1", "protocol": "http", "host": ["{{host}}"], "port": "8000", "path": ["orders", "1"]}
      }
    }
  ],
  "variable": [
    {"key": "host", "value": "localhost"}
  ]
}
